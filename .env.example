# Variáveis de ambiente da API
# Copie este arquivo para .env e preencha com seus valores

# ─── Servidor ───────────────────────────────────────────────────────────────
PORT=3001

# ─── Banco de Dados ─────────────────────────────────────────────────────────
# Formato: postgresql://USUARIO:SENHA@HOST:PORTA/NOME_DO_BANCO
DATABASE_URL=postgresql://postgres:sua_senha@localhost:5432/chdeal_kanban

# ─── Segurança ──────────────────────────────────────────────────────────────
# Qualquer string longa e aleatória (ex: gere em https://passwordsgenerator.net/)
JWT_SECRET=coloque_uma_chave_secreta_longa_aqui

# Chave de autenticação entre a API e o Bot (deve ser igual no bot)
API_KEY=coloque_uma_api_key_aqui

# ─── Discord OAuth2 (para login com Discord) ─────────────────────────────────
# Obtenha em: https://discord.com/developers/applications → sua app → OAuth2
CLIENT_ID=seu_client_id_discord
GUILD_ID=id_do_seu_servidor_discord
DISCORD_TOKEN=token_do_seu_bot
DISCORD_CLIENT_SECRET=seu_client_secret_discord
DISCORD_REDIRECT_URI=http://localhost:3001/auth/discord/callback

# ─── Permissões ─────────────────────────────────────────────────────────────
# IDs Discord separados por vírgula dos usuários administradores
ADMIN_USERS=id_discord_admin1,id_discord_admin2

# ID do cargo de PM no servidor Discord
PM_ROLE_ID=id_do_cargo_pm

# ─── Bot Discord (Webhook) ───────────────────────────────────────────────────
# URL completa do endpoint de webhook do bot
BOT_WEBHOOK_URL=http://localhost:3005/webhook/kanban-event
